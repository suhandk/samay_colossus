{
  "version": 2,
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://samay-colossus.vercel.app/backend/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://samay-colossus.vercel.app/api/:path*"
    },
    {
      "source": "/((?!assets/|icons/|manifest.webmanifest|sw.js|install.js|install.css).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}