  "components": {
    "schemas": {
      "DecisionInput": {
        "properties": {
          "crop": {
            "type": "string",
            "title": "Crop"
          },
          "market": {
            "type": "string",
            "title": "Market"
          },
          "variety": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Variety"
          },
          "grade": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Grade"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "minimum": 0.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          },
          "buyer_price": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Buyer Price"
          },
          "reference_scenario": {
            "type": "boolean",
            "title": "Reference Scenario",
            "default": false
          },
          "required_cash": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Required Cash"
          },
          "cash_deadline": {
            "type": "string",
            "format": "date",
            "title": "Cash Deadline"
          },
          "storage": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsure"
            ],
            "title": "Storage"
          },
          "storage_capacity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Storage Capacity"
          },
          "safe_holding_days": {
            "type": "integer",
            "maximum": 730.0,
            "minimum": 0.0,
            "title": "Safe Holding Days"
          },
          "storage_evidence": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Storage Evidence"
          },
          "minimum_lot": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "minimum": 0.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Minimum Lot"
          },
          "quantity_increment": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "minimum": 0.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity Increment"
          },
          "market_step": {
